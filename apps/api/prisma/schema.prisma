generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LANDLORD
  RENTER
}

enum UnitType {
  ROOM
  APARTMENT
  FLAT
  SHOP
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
}

enum BillItemType {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  OTHER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethodType {
  ESEWA
  FONEPAY
  BANK_TRANSFER
  CASH
  OTHER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties        Property[]
  tenancies         Tenancy[]
  sentInvitations   Invitation[]  @relation("InvitationSender")
  receivedInvites   Invitation[]  @relation("InvitationRecipient")
  paymentMethods    PaymentMethod[]
  verifiedPayments  Payment[]     @relation("PaymentVerifier")
  refreshTokens     RefreshToken[]

  @@index([role])
}

model Property {
  id         String   @id @default(uuid())
  landlordId String
  name       String
  address    String
  city       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  landlord User   @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  units    Unit[]

  @@index([landlordId])
}

model Unit {
  id           String     @id @default(uuid())
  propertyId   String
  name         String
  type         UnitType
  monthlyRent  Decimal    @db.Decimal(12, 2)
  status       UnitStatus @default(VACANT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancies   Tenancy[]
  invitations Invitation[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@index([status])
}

model Tenancy {
  id        String    @id @default(uuid())
  unitId    String
  renterId  String
  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renter User   @relation(fields: [renterId], references: [id], onDelete: Restrict)
  bills  Bill[]

  @@index([unitId])
  @@index([renterId])
  @@index([active])
}

model Bill {
  id           String     @id @default(uuid())
  tenancyId    String
  billingMonth DateTime
  dueDate      DateTime
  status       BillStatus @default(PENDING)
  totalAmount  Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenancy Tenancy    @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  items   BillItem[]
  payments Payment[]

  @@unique([tenancyId, billingMonth])
  @@index([status])
  @@index([dueDate])
}

model BillItem {
  id          String        @id @default(uuid())
  billId      String
  type        BillItemType
  description String
  amount      Decimal       @db.Decimal(12, 2)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([type])
}

model Payment {
  id                  String        @id @default(uuid())
  billId              String
  amount              Decimal       @db.Decimal(12, 2)
  method              PaymentMethodType
  transactionReference String
  proofUrl            String?
  status              PaymentStatus @default(PENDING)
  submittedAt         DateTime      @default(now())
  verifiedAt          DateTime?
  verifiedById        String?

  bill       Bill  @relation(fields: [billId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  receipt    Receipt?

  @@index([billId])
  @@index([status])
  @@index([verifiedById])
  @@index([transactionReference])
}

model PaymentMethod {
  id           String            @id @default(uuid())
  landlordId   String
  type         PaymentMethodType
  name         String
  accountName  String?
  accountNumber String?
  phoneNumber  String?
  qrImageUrl   String?
  instructions String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  landlord User @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([landlordId])
  @@index([active])
}

model Receipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Invitation {
  id            String           @id @default(uuid())
  unitId        String
  senderId      String
  recipientId   String?
  email         String
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  unit        Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sender      User  @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User? @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([unitId])
  @@index([senderId])
  @@index([recipientId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}